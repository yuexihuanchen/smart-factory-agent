<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.smartfactory.mapper.SysRoleMapper">

    <resultMap id="SysRoleResultMap"
               type="com.smartfactory.entity.SysRole">

        <id property="id" column="id"/>

        <result property="roleName"
                column="role_name"/>

        <result property="roleCode"
                column="role_code"/>

        <result property="description"
                column="description"/>

        <result property="createdAt"
                column="created_at"/>

        <result property="updatedAt"
                column="updated_at"/>

    </resultMap>

    <select id="findRolesByUserId"
            resultMap="SysRoleResultMap">

        SELECT
            r.id,
            r.role_name,
            r.role_code,
            r.description,
            r.created_at,
            r.updated_at
        FROM sys_role r
        JOIN sys_user_role ur
            ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}

    </select>

    <select id="findAll"
            resultMap="SysRoleResultMap">

        SELECT
            id,
            role_name,
            role_code,
            description,
            created_at,
            updated_at
        FROM sys_role
        ORDER BY id

    </select>

    <select id="findById"
            parameterType="java.lang.Long"
            resultMap="SysRoleResultMap">

        SELECT
            id,
            role_name,
            role_code,
            description,
            created_at,
            updated_at
        FROM sys_role
        WHERE id = #{id}

    </select>

    <select id="findByCode"
            resultMap="SysRoleResultMap">

        SELECT
            id,
            role_name,
            role_code,
            description,
            created_at,
            updated_at
        FROM sys_role
        WHERE role_code = #{roleCode}
        LIMIT 1

    </select>

    <insert id="insert"
            parameterType="com.smartfactory.entity.SysRole"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO sys_role (
            role_name,
            role_code,
            description
        )
        VALUES (
            #{roleName},
            #{roleCode},
            #{description}
        )

    </insert>

    <update id="update"
            parameterType="com.smartfactory.entity.SysRole">

        UPDATE sys_role
        <set>
            role_name = #{roleName},
            role_code = #{roleCode},
            <if test="description != null">
                description = #{description},
            </if>
        </set>
        WHERE id = #{id}

    </update>

    <delete id="deleteById">

        DELETE FROM sys_role
        WHERE id = #{id}

    </delete>

</mapper>
